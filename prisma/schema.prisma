datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Patient {
  id                 String               @id @default(uuid())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  
  // Relations to category models
  demographics       Demographics?
  diagnosis          Diagnosis?
  medicalHistory     MedicalHistory?
  treatments         Treatments?
  laboratory         Laboratory?
  functional         FunctionalStatus?
  genetic            GeneticCriteria?
  reproductive       ReproductiveHealth?
  safety             SafetyConstraints?
  administrative     Administrative?
  medicalDocuments   MedicalDocument[]
}

model Demographics {
  id             String   @id @default(uuid())
  patientId      String   @unique
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  age            Int
  sexAtBirth     String
  pregnant       String
  breastfeeding  String
  location       String
}

model Diagnosis {
  id                 String   @id @default(uuid())
  patientId          String   @unique
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  diagnosis          String
  confirmationMethod String
  diseaseSubtype     String?
  timeSinceDiagnosis String?
  severityScore      String?
  biomarkerStatus    String?  @db.Text
}

model MedicalHistory {
  id              String   @id @default(uuid())
  patientId       String   @unique
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  comorbidities   String?  @db.Text
  relatedDiseases String?  @db.Text
  surgicalHistory String?  @db.Text
  allergies       String?  @db.Text
}

model Treatments {
  id                 String   @id @default(uuid())
  patientId          String   @unique
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  previousTherapies  String?  @db.Text
  washoutCompleted   String?
  diseaseStatus      String?
  currentMedications String?  @db.Text
  otherTrials        String?
}

model Laboratory {
  id              String   @id @default(uuid())
  patientId       String   @unique
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hemoglobin      Float?
  anc             Int?
  platelets       Int?
  ast             Int?
  alt             Int?
  bilirubin       Float?
  creatinine      Float?
  egfr            Int?
  diseaseSpecific String?  @db.Text
}

model FunctionalStatus {
  id               String   @id @default(uuid())
  patientId        String   @unique
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  ecogScore        String?
  dailyActivities  String?
  cognitiveCapacity String?
}

model GeneticCriteria {
  id               String   @id @default(uuid())
  patientId        String   @unique
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  geneticTesting   String?
  mutations        String?  @db.Text
  mutationType     String?
  diagnosticTest   String?  @db.Text
}

model ReproductiveHealth {
  id                 String    @id @default(uuid())
  patientId          String    @unique
  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fertilityStatus    String?
  contraception      String?
  pregnancyTest      String?
  pregnancyTestDate  DateTime?
}

model SafetyConstraints {
  id               String   @id @default(uuid())
  patientId        String   @unique
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  lvef             Int?
  infections       String?  @db.Text
  qtInterval       Int?
  adverseReactions String?  @db.Text
}

model Administrative {
  id                   String   @id @default(uuid())
  patientId            String   @unique
  patient              Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  informedConsent      String
  complianceWillingness String
  insuranceStatus      String?
  languageComprehension String?
}

model MedicalDocument {
  id          String    @id @default(uuid())
  patientId   String?
  patient     Patient?  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  typeId      String
  label       String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  uploadedAt  DateTime @default(now())
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  role          Role
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

enum Role {
  patient
  doctor
  trial_investigator
}
