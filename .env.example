# Local development environment variables for Trial Bridge
# Copy this file to .env.local and replace placeholders with real values.

# PostgreSQL database connection.
DATABASE_URL="postgresql://username:password@host:port/database"

# Supabase client (browser-side) settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Supabase admin/server-side settings.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional storage bucket name; defaults to "medical-documents" if unset.
SUPABASE_STORAGE_BUCKET=medical-documents

# JWT-based authentication configuration.
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET="replace-with-a-separate-strong-refresh-secret"
REFRESH_TOKEN_EXPIRES_IN=7d
